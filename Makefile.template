# Point de départ du Makefile (à adapter en M0). Le hook Stop dépend de la cible verify-quick.
SHELL := /bin/bash
.DEFAULT_GOAL := verify-quick
EVAL ?= all

.PHONY: verify-quick verify evals dev sandbox-plan sandbox-apply sandbox-destroy update-baseline arch-test

verify-quick:
	go build ./...
	golangci-lint run ./...
	go test -short ./...
	@if [ -d policies ]; then opa check policies && opa test policies; fi
	$(MAKE) arch-test

verify: verify-quick
	go test -tags=integration ./...
	govulncheck ./...
	$(MAKE) evals EVAL=changed

evals:
	go run ./cmd/rempart-evals --suite $(EVAL)

arch-test:
	go test ./internal/archtest/...

dev:
	docker compose up -d temporal postgres openbao

sandbox-plan:
	@test -n "$(SCENARIO)" || (echo "SCENARIO requis"; exit 1)
	./scripts/sandbox.sh plan $(SCENARIO)

# Approbation humaine exigée par la configuration Claude Code (permissions "ask") ET par cette confirmation.
sandbox-apply:
	@test -n "$(SCENARIO)" || (echo "SCENARIO requis"; exit 1)
	@read -p "Appliquer $(SCENARIO) sur le compte SANDBOX ? Tape 'oui' : " a; [ "$$a" = "oui" ]
	./scripts/sandbox.sh apply $(SCENARIO)

sandbox-destroy:
	@test -n "$(SCENARIO)" || (echo "SCENARIO requis"; exit 1)
	@read -p "Détruire $(SCENARIO) sur le compte SANDBOX ? Tape 'oui' : " a; [ "$$a" = "oui" ]
	./scripts/sandbox.sh destroy $(SCENARIO)

# Réservé aux humains (bloqué pour l'agent par le hook guard_bash).
update-baseline:
	go run ./cmd/rempart-evals --suite $(EVAL) --write-baseline

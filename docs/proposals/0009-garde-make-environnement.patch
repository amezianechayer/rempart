+  check 2 "$(printf '{}' | hook "$T/.claude/hooks/stop_verify.py")" "stop : Makefile non refait depuis Makefile.sh (-r)"
+  rm -f "$T/Makefile.sh"
 else
   check 2 "$(printf '{}' | hook "$T/.claude/hooks/stop_verify.py")" "stop : make absent compte comme un échec"

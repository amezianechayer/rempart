+// golangciRunRe (obligation (ce), T6): the install of golangci-lint at version,
+// then the check of its module hash against a pinned h1: hash.
+func golangciRunRe(version string) *regexp.Regexp {
+	v := regexp.QuoteMeta(version)
+	return regexp.MustCompile(`^go install github\.com/golangci/golangci-lint/v2/cmd/golangci-lint@` + v + `\n` +
+		`test "\$\(go version -m "\$\(go env GOPATH\)/bin/golangci-lint" \| awk '\$1 == "mod" \{print \$2, \$3, \$4\}'\)" = ` +
+		`"github\.com/golangci/golangci-lint/v2 ` + v + ` h1:[A-Za-z0-9+/]{43}="$`)
+}
+
+// ciExpressions is the closed list of the expressions of the workflow
+// (obligations (bq), (br), (cg), T82): every ${{ ... }} of the file, comments
+// included, is one of them.
+var ciExpressions = []string{
+	"${{ " + ciGroup + " }}",
+	"${{ github.event_name == 'pull_request' }}",
+	ciBase,
+}
+
+func checkCIExpressions(_ ciWorkflow, src string) (p problemList) {
+	closed := func(where, text string) {
+		found := ciExpressionRe.FindAllString(text, -1)
+		for _, e := range found {
+			if !slices.Contains(ciExpressions, e) {
+				p.addf("%s: expression %q outside the closed list %q", where, e, ciExpressions)
+			}
+		}
+		if n := strings.Count(text, "${{"); n != len(found) {
+			p.addf("%s: %d expression openings, %d closed expressions on one line", where, n, len(found))
+		}
+	}
+	closed("text", src)
+	// Review of M3-T01: a YAML escape (\x24{{, \u0024{{) is decoded into an
+	// expression GitHub evaluates; the closed list applies to the decoded
+	// scalars too.
+	var doc yaml.Node
+	if err := yaml.Unmarshal([]byte(src), &doc); err != nil {
+		p.addf("decoded scalars: %v", err)
+		return p
+	}
+	var walk func(n *yaml.Node)
+	walk = func(n *yaml.Node) {
+		if n.Kind == yaml.ScalarNode {
+			closed(fmt.Sprintf("line %d (decoded)", n.Line), n.Value)
+		}
+		for _, c := range n.Content {
+			walk(c)
+		}
+	}
+	walk(&doc)
+	return p
+}
+
+var ciExpressionRe = regexp.MustCompile(`\$\{\{.*?\}\}`)

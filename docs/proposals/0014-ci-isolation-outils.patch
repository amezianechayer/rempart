+      - name: Tool isolation prerequisites (ADR 0015, H-CI-3)
+        # Ubuntu 24.04 restricts unprivileged user namespaces through AppArmor;
+        # the runner is ephemeral, the restriction is lifted for this job only.
+        run: |
+          sysctl kernel.apparmor_restrict_unprivileged_userns || true
+          sudo sysctl -w kernel.apparmor_restrict_unprivileged_userns=0
+          unshare -U -r -n -p -f --mount-proc true; echo "unshare rc=$?"
+          tr , '\n' < /sys/kernel/security/lsm | grep -cx landlock || true
       - name: Docker preflight
         run: make -f Makefile dev-preflight
       - name: make verify

+// ciIsolationStep lifts the AppArmor restriction of Ubuntu 24.04 on
+// unprivileged user namespaces, on the ephemeral runner (ADR 0015, H-CI-3).
+const ciIsolationStep = `sysctl kernel.apparmor_restrict_unprivileged_userns || true
+sudo sysctl -w kernel.apparmor_restrict_unprivileged_userns=0
+unshare -U -r -n -p -f --mount-proc true; echo "unshare rc=$?"
+tr , '\n' < /sys/kernel/security/lsm | grep -cx landlock || true`
+
